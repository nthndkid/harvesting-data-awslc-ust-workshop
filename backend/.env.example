# Database (Amazon RDS - PostgreSQL)
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="projecthub"

# AWS Configuration
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Amazon S3
S3_BUCKET_NAME="projecthub-storage"

# Amazon DynamoDB
DYNAMODB_AUDIT_LOGS="projecthub-audit-logs"
DYNAMODB_ACCESS_LOGS="projecthub-access-logs"
DYNAMODB_TRANSACTION_LOGS="projecthub-transaction-logs"
