# ── Database (AWS RDS - PostgreSQL) ──────────────────────────────────────────────────────────
# DB_HOST → RDS Console → your instance → Connectivity & security → Endpoint
DB_HOST=
DB_PORT=5432
DB_NAME=projecthub
# DB_USER / DB_PASSWORD → set when you created the RDS instance
DB_USER=
DB_PASSWORD=

# ── AWS Configuration (used by both S3 and DynamoDB) ───────────────────────────────────────
AWS_REGION=ap-southeast-1
# IAM Console → Users → your user → Security credentials → Access keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── S3 ────────────────────────────────────────────────────────────────────────
# The exact bucket name you created in S3
S3_BUCKET_NAME=

# ── DynamoDB ──────────────────────────────────────────────────────────────────
# These match the table names from the AWS setup guide — don't change them
DYNAMODB_TABLE="projecthub-yourname-events"